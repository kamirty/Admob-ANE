{
  "rules": {
    "kwc": {
      "$code": {
        ".read": "$code.length === 6",
        ".write": "auth != null && data.child('m/o').val() === auth.uid && !newData.exists()",
        "m": {
          ".write": "auth != null && (data.exists() ? data.child('o').val() === auth.uid : newData.child('o').val() === auth.uid)",
          ".validate": "newData.hasChildren(['o', 'q', 'x', 'mu', 'op', 'ex', 'c'])",
          "o": { ".validate": "newData.val() === auth.uid" },
          "q": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
          "x": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "mu": { ".validate": "newData.isBoolean()" },
          "op": { ".validate": "newData.isBoolean()" },
          "ex": { ".validate": "newData.isNumber() && newData.val() <= now + 87000000" },
          "c": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "e": {
          "$id": {
            ".write": "!data.exists() && newData.exists() && root.child('kwc/' + $code + '/m').exists() && ((auth != null && root.child('kwc/' + $code + '/m/o').val() === auth.uid) || (root.child('kwc/' + $code + '/m/op').val() === true && root.child('kwc/' + $code + '/m/ex').val() > now))",
            ".validate": "newData.hasChildren(['w', 'p', 't']) && $id.length <= 24",
            "w": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "p": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
